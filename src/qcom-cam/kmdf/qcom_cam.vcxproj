    <ResourceCompile><PreprocessorDefinitions>ALS_DRIVER_VERSION=$(CamDriverVersionComma);ALS_DRIVER_VERSION_TEXT=$(CamDriverVersion);%(PreprocessorDefinitions)</PreprocessorDefinitions></ResourceCompile>
  </ItemDefinitionGroup>
