; Copyright (C) Microsoft Corporation. All rights reserved.
[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%ProviderString%
DriverVer=10/31/2026,26.10.31.0
CatalogFile=syna_touch.cat
PnpLockdown=1

[DestinationDirs]
KMDriverCopy=13

[SourceDisksNames]
1=%DiskDesc%,,,

[SourceDisksFiles]
syna_touch.sys=1

[Manufacturer]
%ManufacturerString%=Microsoft,NT$ARCH$.10.0...22000

[Microsoft.NT$ARCH$.10.0...22000]
%DeviceDesc%=syna_touch, ACPI\SYNA3910

[syna_touch.NT]
CopyFiles=KMDriverCopy

[syna_touch.NT.Filters]
AddFilter=syna_touch,,syna_touch_Filter_Install

[syna_touch_Filter_Install]
FilterPosition=Lower

[syna_touch.NT.Services]
AddService=syna_touch,0,syna_touch_Service_Inst
AddService=mshidkmdf,0x2,mshidkmdf_Service_Inst

[mshidkmdf_Service_Inst]
DisplayName    = %mshidkmdf.SvcName%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\mshidkmdf.sys

[syna_touch_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\syna_touch.sys

[syna_touch.NT.Wdf]
KmdfService=syna_touch, syna_touch_wdfsect

[syna_touch_wdfsect]
KmdfLibraryVersion=$KMDFVERSION$

[KMDriverCopy]
syna_touch.sys

[Strings]
ProviderString     = "AnyLaySys"
ManufacturerString = "Synaptics"
DeviceDesc         = "Synaptics S3910 Touchscreen Controller"
ServiceDesc        = "Synaptics S3910 Touchscreen Driver"
mshidkmdf.SvcName  = "Pass-through HID to KMDF Filter Driver"
DiskDesc           = "AnyLaySys S3910 Touchscreen Driver"
