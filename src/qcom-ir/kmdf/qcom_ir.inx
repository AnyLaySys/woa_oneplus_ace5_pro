[SourceDisksNames]
1=%Description%,,,
[SourceDisksFiles]
qcom_ir.sys=1
qcom_ir_power.exe=1
[Manufacturer]
%Manufacturer%=Devices,NT$ARCH$.10.0...22000
[Devices.NT$ARCH$.10.0...22000]
%Description%=Install,ACPI\HMRI0001
[Install.NT]
CopyFiles=DriverCopy
