[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/06/2026,26.11.6.4
CatalogFile=qcom_bluetooth.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
qcom_bluetooth.sys=1

[Manufacturer]
%Manufacturer%=Qualcomm,NT$ARCH$.10.0...26100

[Qualcomm.NT$ARCH$.10.0...26100]
%Device%=Qbt,ACPI\HMRB7861

[Qbt.NT]
CopyFiles=Qbt.Files

[Qbt.Files]
qcom_bluetooth.sys

[Qbt.NT.Services]
AddService=qcom_bluetooth,0x00000002,Qbt.Service

[Qbt.Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\qcom_bluetooth.sys

[Qbt.NT.Wdf]
KmdfService=qcom_bluetooth,Qbt.Wdf

[Qbt.Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
Provider="AnyLaySys"
Manufacturer="Qualcomm"
Device="Qualcomm WCN7861 Bluetooth UART Controller"
Disk="AnyLaySys Bluetooth Driver"
