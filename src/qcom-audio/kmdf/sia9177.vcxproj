  </ItemGroup>

  <ItemGroup>

    <ClInclude Include="..\sia9177.h" />

  </ItemGroup>

  <ItemGroup>

    <Inf Include="sia9177.inx" />

    <FilesToPackage Include="$(TargetPath)" />

  </ItemGroup>

  <PropertyGroup>
    <WoAProjectRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..'))</WoAProjectRoot>
    <OutDir>$(WoAProjectRoot)\out\qcom-audio\$(Platform)\$(Configuration)\bin\</OutDir>
    <IntDir>$(WoAProjectRoot)\out\qcom-audio\$(Platform)\$(Configuration)\obj\</IntDir>
