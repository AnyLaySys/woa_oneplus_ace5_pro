  </ItemGroup>

  <PropertyGroup Label="Globals">

    <ProjectGuid>{5A2E9C41-7B3D-4F1E-9A6C-1D8E3B7F9177}</ProjectGuid>

    <RootNamespace>sia9177</RootNamespace>

    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>

