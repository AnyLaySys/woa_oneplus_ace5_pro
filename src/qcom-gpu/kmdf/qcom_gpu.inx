[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/08/2026,26.11.8.0
CatalogFile=qcom_gpu.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
qcom_gpu.sys=1

[Manufacturer]
%Manufacturer%=Qualcomm,NT$ARCH$.10.0...26100

[Qualcomm.NT$ARCH$.10.0...26100]
%Device%=Gpu,ACPI\HMRG0830

[Gpu.NT]
CopyFiles=Gpu.Files

[Gpu.Files]
qcom_gpu.sys

[Gpu.NT.Services]
AddService=qcom_gpu,0x00000002,Gpu.Service

[Gpu.Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\qcom_gpu.sys

[Gpu.NT.Wdf]
KmdfService=qcom_gpu,Gpu.Wdf

[Gpu.Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
Provider="AnyLaySys"
Manufacturer="Qualcomm"
Device="Qualcomm Adreno 830"
Disk="AnyLaySys GPU Driver"
