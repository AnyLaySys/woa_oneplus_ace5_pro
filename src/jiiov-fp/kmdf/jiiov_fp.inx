[Version]
Signature="$WINDOWS NT$"
Class=Biometric
ClassGuid={53D29EF7-377C-4D14-864B-EB3A85769359}
Provider=%Provider%
DriverVer=11/24/2026,26.11.24.34
CatalogFile=jiiov_fp.cat
PnpLockdown=1

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%Description%,,,

[SourceDisksFiles]
jiiov_fp.sys=1

[Manufacturer]
%Manufacturer%=Devices,NT$ARCH$.10.0...22000

[Devices.NT$ARCH$.10.0...22000]
%Description%=Install,ACPI\HMRF0301
%Description%=Install,ROOT\JIIOV_FP

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
jiiov_fp.sys

[Install.NT.HW]
AddReg=Hardware

[Hardware]
HKR,,DeviceCharacteristics,0x00010001,0x100

[Install.NT.Services]
AddService=jiiov_fp,0x00000002,Service

[Service]
DisplayName=%Description%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\jiiov_fp.sys

[Install.NT.Wdf]
KmdfService=jiiov_fp,Framework

[Framework]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
Provider="AnyLaySys"
Manufacturer="Jiiov"
Description="Jiiov JV0301 Fingerprint Sensor"
