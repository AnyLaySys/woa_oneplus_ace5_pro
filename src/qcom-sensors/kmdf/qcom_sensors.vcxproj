<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{37203720-2026-1117-8000-731945102001}</ProjectGuid>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">ARM64</Platform>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion><DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <DriverType>KMDF</DriverType><PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType><UseDebugLibraries>false</UseDebugLibraries>
    <Driver_SpectreMitigation>Spectre</Driver_SpectreMitigation>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>qcom_sensors</TargetName>
    <SensorsVersionDate Condition="'$(SensorsVersionDate)' == ''">$([System.DateTime]::Now.ToString('yyyy-MM-dd'))</SensorsVersionDate>
    <SensorsRevision Condition="'$(SensorsRevision)' == ''">42</SensorsRevision>
    <SensorsDriverDate>$([System.DateTime]::Parse('$(SensorsVersionDate)').ToString('MM/dd/yyyy'))</SensorsDriverDate>
    <SensorsDriverVersion>$([System.DateTime]::Parse('$(SensorsVersionDate)').ToString('yy.M.d')).$(SensorsRevision)</SensorsDriverVersion>
    <SensorsDriverVersionComma>$([System.String]::Copy('$(SensorsDriverVersion)').Replace('.', ','))</SensorsDriverVersionComma>
    <Inf2CatUseLocalTime>true</Inf2CatUseLocalTime>
    <OutDir>$(MSBuildThisFileDirectory)..\..\..\out\qcom-sensors\ARM64\Release\bin\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\..\out\qcom-sensors\ARM64\Release\obj\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile><DebugInformationFormat>None</DebugInformationFormat><PreprocessorDefinitions>_UNICODE;UNICODE;POOL_NX_OPTIN=1;%(PreprocessorDefinitions)</PreprocessorDefinitions><LanguageStandard_C>stdc17</LanguageStandard_C><WarningLevel>Level4</WarningLevel><TreatWarningAsError>true</TreatWarningAsError><Optimization>MinSpace</Optimization></ClCompile>
    <Link><GenerateDebugInformation>false</GenerateDebugInformation><Profile>false</Profile></Link>
    <Inf><SpecifyDriverVerDirectiveDate>true</SpecifyDriverVerDirectiveDate><SpecifyDriverVerDirectiveVersion>true</SpecifyDriverVerDirectiveVersion><DateStamp>$(SensorsDriverDate)</DateStamp><TimeStamp>$(SensorsDriverVersion)</TimeStamp></Inf>
    <ResourceCompile><PreprocessorDefinitions>ALS_DRIVER_VERSION=$(SensorsDriverVersionComma);ALS_DRIVER_VERSION_TEXT=$(SensorsDriverVersion);%(PreprocessorDefinitions)</PreprocessorDefinitions></ResourceCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\als.c" />
    <ResourceCompile Include="qcom_sensors.rc" /><Inf Include="qcom_sensors.inx" /><FilesToPackage Include="$(TargetPath)" />
    <FilesToPackage Include="$(OutDir)qcom_sensors_service.exe" />
  </ItemGroup>
  <Target Name="BuildSensorService" BeforeTargets="PrepareForBuild">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\service.vcxproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(Platform);OutDir=$(OutDir);IntDir=$(IntDir)service\;SensorsDriverVersion=$(SensorsDriverVersion);SensorsDriverVersionComma=$(SensorsDriverVersionComma)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\native\qcom_sensors_native.vcxproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(Platform);OutDir=$(OutDir);IntDir=$(IntDir)native\;SensorsVersionDate=$(SensorsVersionDate);SensorsRevision=$(SensorsRevision);SkipPackageVerification=true;SignMode=Off" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
