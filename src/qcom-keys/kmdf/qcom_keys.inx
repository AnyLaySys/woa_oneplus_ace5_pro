[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%ProviderString%
DriverVer=11/16/2026,26.11.16.0
CatalogFile=qcom_keys.cat
PnpLockdown=1

[DestinationDirs]
KMDriverCopy=13

[SourceDisksNames]
1=%DiskDesc%,,,

[SourceDisksFiles]
qcom_keys.sys=1

[Manufacturer]
%ManufacturerString%=Qualcomm,NT$ARCH$.10.0...22000

[Qualcomm.NT$ARCH$.10.0...22000]
%DeviceDesc%=qcom_keys, ACPI\HMRK0001

[qcom_keys.NT]
CopyFiles=KMDriverCopy

[qcom_keys.NT.Filters]
AddFilter=qcom_keys,,qcom_keys_Filter_Install

[qcom_keys_Filter_Install]
FilterPosition=Lower

[qcom_keys.NT.Services]
AddService=qcom_keys,0,qcom_keys_Service_Inst
AddService=mshidkmdf,0x2,mshidkmdf_Service_Inst

[mshidkmdf_Service_Inst]
DisplayName    = %mshidkmdf.SvcName%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\mshidkmdf.sys

[qcom_keys_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\qcom_keys.sys

[qcom_keys.NT.Wdf]
KmdfService=qcom_keys, qcom_keys_wdfsect

[qcom_keys_wdfsect]
KmdfLibraryVersion=$KMDFVERSION$

[KMDriverCopy]
qcom_keys.sys

[Strings]
ProviderString     = "AnyLaySys"
ManufacturerString = "Qualcomm"
DeviceDesc         = "OnePlus Hummer Power and Volume Buttons"
ServiceDesc        = "Qualcomm PMIC Button Driver"
mshidkmdf.SvcName  = "Pass-through HID to KMDF Filter Driver"
DiskDesc           = "AnyLaySys Button Driver"
